# Box-hardening kernel config overrides.
#
# Merged ONTO Alpine's linux-virt base config (`config-<ver>-virt`) via
# `scripts/kconfig/merge_config.sh`, then `make olddefconfig`; the result is checked by
# image-builder's assert_kernel_config (kernel-config-pins.toml) BEFORE `make`. These are the
# OVERRIDES — the base config supplies everything else. Mirrors the spec build-pipeline CONFIG
# list; every symbol here is also asserted post-olddefconfig (kept consistent by a test).
#
# NB stock linux-virt 6.18.33 baseline (verified from the apk): IMA off, modules on, dm-verity
# modular, lockdown-LSM already on -- the turn-ons + the modules-off flip below are the delta.
# NB: no CONFIG_<sym> tokens in comments -- merge_config.sh's `grep -w` would mis-match them.

# --- security / defense-by-composition (defense layers 4/5/6) ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# CONFIG_MODULES is not set
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
CONFIG_IMA_APPRAISE_REQUIRE_POLICY_SIGS=y
CONFIG_IMA_LOAD_X509=y
# Declare the cert paths explicitly (audit I-4) rather than leaning on the kernel default; the
# initramfs places the leaf DERs at exactly these paths (build_initramfs). Pinned in
# kernel-config-pins.toml so a default-drift is caught at the CONFIG-assert gate.
CONFIG_IMA_X509_PATH="/etc/keys/x509_ima.der"
CONFIG_EVM=y
CONFIG_EVM_LOAD_X509=y
CONFIG_EVM_X509_PATH="/etc/keys/x509_evm.der"
CONFIG_SECURITY_YAMA=y
# CONFIG_BPF_JIT is not set
# CONFIG_INITRAMFS_PRESERVE_XATTRS (spec) REMOVED — phantom symbol, absent from mainline 6.18.33 (R8 class).

# --- R.4 reproducibility (audit R1 M-1): re-assert the kernel-determinism assumption here (merged
#     PRE-olddefconfig) so a base-config drift fails closed before the post-olddefconfig pin runs.
#     latent_entropy is the ONLY build randomness (force on); randstruct OFF (its own seed breaks repro). ---
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_RANDSTRUCT_NONE=y

# --- integrity signature infrastructure: the intermediate deps that make the IMA/EVM x509 +
#     policy-sig pins ENABLEABLE. The spec's CONFIG list named the end-goal symbols
#     (IMA_APPRAISE_REQUIRE_POLICY_SIGS, *_LOAD_X509, SYSTEM_TRUSTED_KEYS) but omitted these;
#     empirical `make olddefconfig` on real 6.18.33 source DROPPED REQUIRE_POLICY_SIGS without
#     them (Task 1.3 finding — flag for the box audit + a spec CONFIG-list correction). Chain
#     (security/integrity/Kconfig): INTEGRITY_SIGNATURE -> ASYMMETRIC_KEYS -> TRUSTED_KEYRING
#     (TRUSTED_KEYRING is default-y once SYSTEM_TRUSTED_KEYRING + ASYMMETRIC_KEYS hold — but it
#     INSTALLS the .ima/.evm keyring CA-chain link restriction (restrict_link_by_digsig_builtin),
#     the heart of the appraisal-trust model, so it is declared EXPLICITLY + PINNED (audit M-1 R4),
#     never left to the default: a silent drop of any link in this chain now aborts the build rather
#     than silently unrestricting the integrity keyrings). REQUIRE_POLICY_SIGS depends on
#     IMA_APPRAISE_BUILD_POLICY. All four are pinned in kernel-config-pins.toml.
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_INTEGRITY_TRUSTED_KEYRING=y
CONFIG_IMA_APPRAISE_BUILD_POLICY=y

# --- functional FS / device-mapper (must be built-in under MODULES=n) ---
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_LOOP=y

# --- networking + virtio (no VIRTIO_NET => guest has no network => dropbear fails) ---
CONFIG_NET=y
CONFIG_INET=y
# inet-table ip6 nft rule must keep loading, else nftables-load reboot-loops). Pinned post-olddefconfig too.
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
# M-2: kvm-clock / paravirt clocksource — the time-sync decision + the ACME --min-epoch gate depend on
# it (drift-free guest wall-time). Inherited unpinned from linux-virt; pin so a drift fails the build,
# not silently. KVM_GUEST=y selects PARAVIRT_CLOCK; both asserted to match the pins.
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y

# --- disk transports (C3 portability, audit L-1): the box's boot disk varies by KVM hypervisor —
#     virtio-blk (above; Infomaniak), virtio-scsi, NVMe, or emulated SATA/AHCI. The vps-kvm USB shed is
#     USB-ONLY precisely so these STAY; PIN them (force-set + assert) so a base-config drift that drops a
#     transport FAILS the build instead of silently shipping a box that won't boot on that hypervisor class
#     (same fail-closed discipline as VIRTIO_BLK/VIRTIO_NET). Base ships SCSI/ATA/SATA_AHCI =y and the rest
#     =m (promoted to =y builtin under MODULES=n); force =y pins the intent regardless. SHARED — both
#     substrates carry them (bare-metal boots off a SATA / USB-storage disk that rides the same sd stack). ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# ONE plain kernel serves BOTH firmwares: EFI/EFI_STUB make the bzImage a PE the rambutan
# loader LoadImage's (firmware re-verifies vs db under SB); the console chain (firmware
# framebuffer -> simpledrm -> fbcon) makes a halted verified boot diagnosable on screen.
# Operability, not boot policy — policy lives in the signed loader, never kernel config.
# Inherited =y from the linux-virt base; force-set to match the pins (fragment<->pins
# consistency), so a base drift self-heals here and a kconfig-dependency drop still
# aborts at the pin gate. Harmless on SeaBIOS (stub dormant; fbcon already in use).
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- core kernel runtime (init flow step 1: mount /proc + /sys + /dev) ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK=y

# --- cgroup-v2 memory controller (dha AI-tenant confinement — the C1 keystone). The box's
# MODULES=n kernel must ship the memory controller: the whole tenant memory defense reduces to one
# root-owned per-tenant memory.max ceiling, impossible without it. Force =y so a base/olddefconfig
# drift fails the post-olddefconfig pin gate, not a silent loss. The pids controller backs the
# per-job descendant pids cap; swap is on so the swapless swap.max=0 belt has its knob (accounting
# is automatic with the memory controller + swap — no separate phantom symbol). ---
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_SWAP=y

# --- IMA/EVM trust anchor: operator CA cert embedded into .builtin_trusted_keys. The CA vouches for
# the IMA/EVM leaf certs (loaded onto .ima/.evm at boot from /etc/keys); staging the IMA leaf here was
CONFIG_SYSTEM_TRUSTED_KEYS="certs/recipes-ca.pem"

# --- USB boot media (C3): substrate-differentiated, NOT in this shared fragment. Bare-metal-uefi boots
# off USB media so kernel-hardening-baremetal.config ENABLES the USB host/storage stack; a KVM VPS never
# boots off USB so kernel-hardening-vpskvm.config DISABLES it (a fail-closed CONFIG_USB-prefix guard
# asserts it stays off). Deliberately USB-only — the DISK transports (SCSI/ATA/NVMe/virtio-scsi) are
# force-set + PINNED in the disk-transports group above (audit L-1), kept on BOTH substrates so the box
# boots on any KVM hypervisor's disk. ---
